# ──────────────────────────────────────────────
#  GlobeVibe Environment Variables
#  Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# PostgreSQL connection string
# Free database → https://neon.tech  (click "New Project", copy connection string)
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secrets — change these to long random strings!
JWT_SECRET=replace_with_64_random_chars
ADMIN_JWT_SECRET=replace_with_another_64_random_chars

# M-Pesa via Lipana Technologies (https://lipanatechnologies.dev)
LIPANA_BASE_URL=https://api.lipanatechnologies.dev
LIPANA_API_KEY=your_api_key_here
LIPANA_SHORTCODE=your_mpesa_shortcode
LIPANA_PASSKEY=your_mpesa_passkey

# Leave blank when deploying to Vercel (handled automatically)
VITE_API_URL=
